# Copy this file, name the copy ".env", and fill it in.
# Only used when you run the script on your own computer.
# (On GitHub, the same values go in Settings > Secrets instead.)

# The Gmail address that sends the digest
EMAIL_ADDRESS=you@gmail.com

# A Gmail *app password* (16 letters), NOT your normal password.
# Make one at https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Where the digest goes. Leave empty to send it to yourself.
# Several addresses: separate them with commas.
EMAIL_TO=

# Optional: turns on the AI summary at the top of the email.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
